{
    "cli": {
        "version": ">- 16.0.0"
    },
    "build": {
        "dev": {
            "developmentClient": true,
            "distribution": "internal",
            "env": {
                "EXPO_PUBLIC_BUILD_TYPE": "dev"
            },
            "ios": {
                "simulator": true
            },
            "android": {
                "buildType": "apk"
            }
        },
        "sim": {
            "developmentClient": true,
            "distribution": "internal",
            "withoutCredentials": true,
            "env": {
                "EXPO_PUBLIC_BUILD_TYPE": "dev"
            },
            "ios": {
                "simulator": true
            },
            "android": {
                "buildType": "apk"
            }
        },
        "release": {
            "distribution": "internal",
            "env": {
                "EXPO_PUBLIC_BUILD_TYPE": "release",
                "EAS_LOCAL_BUILD_SKIP_CLEANUP": 0,
                "EAS_LOCAL_BUILD_WORKINGDIR": "./build",
                "EAS_LOCAL_BUILD_ARTIFACT_DIR": "./build"
            }
        }
    }
}
